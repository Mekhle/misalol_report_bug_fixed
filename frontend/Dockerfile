FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
ARG API_PROXY_TARGET=http://api:8000
ARG NEXT_PUBLIC_AUTH_ORIGIN=https://misa.lol
ARG NEXT_PUBLIC_MEDIA_HOSTS=r2.misa.lol
ARG MISA_NEXT_CORE_ROLLOUT=false
ENV API_PROXY_TARGET=$API_PROXY_TARGET
ENV NEXT_PUBLIC_AUTH_ORIGIN=$NEXT_PUBLIC_AUTH_ORIGIN
ENV NEXT_PUBLIC_MEDIA_HOSTS=$NEXT_PUBLIC_MEDIA_HOSTS
ENV MISA_NEXT_CORE_ROLLOUT=$MISA_NEXT_CORE_ROLLOUT
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0"]
