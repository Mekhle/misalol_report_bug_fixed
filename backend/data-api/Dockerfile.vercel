FROM rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/prostgres_db /usr/local/bin/prostgres_db
RUN useradd --system --uid 65532 --no-create-home dataapi
# Vercel supplies PORT at runtime. The binary uses PORT when LISTEN_ADDR is unset.
EXPOSE 80
USER dataapi
CMD ["/usr/local/bin/prostgres_db"]
